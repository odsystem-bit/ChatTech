<?php
// Génération PDF côté serveur - utilise FPDF
// Endpoints: ?action=pdf_fiches&id=XXX, ?action=pdf_rapport&id=XXX
// Mise en page propre (sans templates JPG originaux)

require_once __DIR__ . '/vendor/setasign/fpdf/fpdf.php';

define('DB_HOST', 'localhost');
define('DB_NAME', 'u795734321_fibre');
define('DB_USER', 'u795734321_fibretrack');
define('DB_PASS', '@Stan52168223');
define('DB_CHARSET', 'utf8mb4');

function db() {
  static $pdo = null;
  if ($pdo === null) {
    $dsn = 'mysql:host=' . DB_HOST . ';dbname=' . DB_NAME . ';charset=' . DB_CHARSET;
    $pdo = new PDO($dsn, DB_USER, DB_PASS, [
      PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
      PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    ]);
  }
  return $pdo;
}

function getIntervention($id) {
  $stmt = db()->prepare('SELECT * FROM interventions WHERE id = ?');
  $stmt->execute([$id]);
  $r = $stmt->fetch();
  if (!$r) return null;
  $r['materiel_pose'] = json_decode($r['materiel_pose'] ?? '{}', true);
  $r['points_gps'] = json_decode($r['points_gps'] ?? '[]', true);
  $r['whatsapp_photos'] = json_decode($r['whatsapp_photos'] ?? '[]', true);
  $r['port_disponible'] = (bool)$r['port_disponible'];
  $r['client_confirme_emplacement'] = (bool)$r['client_confirme_emplacement'];
  $r['remise_equipement_ok'] = (bool)$r['remise_equipement_ok'];
  $r['travaux_conformes'] = (bool)$r['travaux_conformes'];
  $r['emplacement_valide'] = (bool)$r['emplacement_valide'];
  $r['travail_propre'] = (bool)$r['travail_propre'];
  $r['service_teste'] = (bool)$r['service_teste'];
  $r['service_fonctionne'] = (bool)$r['service_fonctionne'];
  $r['explications_donnees'] = (bool)$r['explications_donnees'];
  $r['recommanderait'] = (bool)$r['recommanderait'];
  $r['accepte_recontact'] = (bool)$r['accepte_recontact'];
  return $r;
}

class ChaptechPDF extends FPDF {

  function Header() {}
  function Footer() {
    $this->SetY(-15);
    $this->SetFont('Helvetica', '', 7);
    $this->SetTextColor(150, 150, 150);
    $this->Cell(0, 5, 'CHAPTECH - Page ' . $this->PageNo(), 0, 0, 'C');
    $this->SetTextColor(0, 0, 0);
  }

  function drawText($x, $y, $txt, $size = 10, $font = 'Helvetica', $style = '', $color = [0, 0, 0]) {
    if (strpos($font, '-') !== false) {
      $parts = explode('-', $font);
      $font = $parts[0];
      $styleMap = ['Bold' => 'B', 'Oblique' => 'I', 'BoldOblique' => 'BI'];
      $style = $styleMap[$parts[1] ?? ''] ?? $style;
    }
    $this->SetFont($font, $style, $size);
    $this->SetTextColor($color[0], $color[1], $color[2]);
    $this->SetXY($x, $y);
    $this->Cell(0, $size * 0.35, utf8_decode($txt));
    $this->SetTextColor(0, 0, 0);
  }

  function drawRect($x, $y, $w, $h, $style = 'D') {
    $this->Rect($x, $y, $w, $h, $style);
  }

  function drawLine($x1, $y1, $x2, $y2) {
    $this->Line($x1, $y1, $x2, $y2);
  }

  function drawCheckbox($x, $y, $checked = false, $size = 4) {
    $this->Rect($x, $y, $size, $size);
    if ($checked) {
      $this->SetFont('Helvetica', 'B', 8);
      $this->SetXY($x + 0.5, $y - 0.5);
      $this->Cell($size - 1, $size + 1, 'X');
    }
  }

  function drawSignature($x, $y, $w, $label, $name, $signature = null) {
    $this->drawRect($x, $y, $w, 30);
    $this->drawText($x + 2, $y + 2, $label, 7, 'Helvetica-Bold');
    if ($name) {
      $this->drawText($x + 2, $y + 12, utf8_decode($name), 11, 'Helvetica', '', [20, 46, 140]);
    }
    if ($signature && strpos($signature, 'data:image') === 0) {
      $base64 = explode(',', $signature)[1] ?? '';
      $imgData = base64_decode($base64);
      if ($imgData) {
        $tmpFile = tempnam(sys_get_temp_dir(), 'sig') . '.png';
        file_put_contents($tmpFile, $imgData);
        try {
          $this->Image($tmpFile, $x + $w * 0.5, $y + 8, $w * 0.4, 18);
        } catch (Exception $e) {}
        @unlink($tmpFile);
      }
    }
  }

  function embedPhoto($base64Data, $x, $y, $w, $h) {
    if (!$base64Data || strpos($base64Data, 'data:image') !== 0) return false;
    $base64 = explode(',', $base64Data)[1] ?? '';
    $imgData = base64_decode($base64);
    if (!$imgData) return false;
    $tmpFile = tempnam(sys_get_temp_dir(), 'photo') . '.jpg';
    file_put_contents($tmpFile, $imgData);
    try {
      $this->Image($tmpFile, $x, $y, $w, $h);
      @unlink($tmpFile);
      return true;
    } catch (Exception $e) {
      @unlink($tmpFile);
      return false;
    }
  }
}

function generateFichesPDF($d) {
  $pdf = new ChaptechPDF();
  $pdf->SetAutoPageBreak(true, 20);
  $margin = 15;
  $pageW = 210;
  $pageH = 297;
  $contentW = $pageW - 2 * $margin;

  $dateStr = date('d/m/Y', strtotime($d['date'] ?? 'now'));

  // ===== Page 1: Fiche de Mise en Service (SBIN) =====
  $pdf->AddPage();

  $y = $margin;

  // Header
  $pdf->drawText($margin, $y, 'Fiche de Mise en Service - SBIN', 14, 'Helvetica-Bold', '', [13, 25, 90]);
  $y += 10;
  $pdf->drawLine($margin, $y, $margin + $contentW, $y);
  $y += 8;

  // Section 1: Identification
  $pdf->drawText($margin, $y, 'Identification', 10, 'Helvetica-Bold', '', [13, 25, 90]);
  $y += 6;
  $idRows = [
    ['Date d\'intervention', $dateStr],
    ['Client', $d['nom_client'] ?? ''],
    ['Ligne', $d['telephone_ligne'] ?? ''],
    ['Mobile', $d['mobile'] ?? ''],
    ['Déclaration du client', $d['nom_client_declaration'] ?? $d['nom_client'] ?? ''],
  ];
  foreach ($idRows as $row) {
    $pdf->drawRect($margin, $y, 70, 6);
    $pdf->drawRect($margin + 70, $y, $contentW - 70, 6);
    $pdf->drawText($margin + 2, $y + 1, $row[0], 7, 'Helvetica-Bold');
    $pdf->drawText($margin + 72, $y + 1, utf8_decode($row[1]), 8, 'Helvetica', '', [13, 25, 90]);
    $y += 6;
  }
  $y += 4;

  // Section 2: Service
  $pdf->drawText($margin, $y, 'Type de service', 10, 'Helvetica-Bold', '', [13, 25, 90]);
  $y += 6;
  $pdf->drawCheckbox($margin, $y, ($d['etat'] ?? '') === 'PON');
  $pdf->drawText($margin + 8, $y, 'PON', 9);
  $pdf->drawCheckbox($margin + 40, $y, ($d['etat'] ?? '') === 'Cuivre');
  $pdf->drawText($margin + 48, $y, 'Cuivre', 9);
  $y += 10;

  // Section 3: Date de mise en service
  $pdf->drawRect($margin, $y, 70, 6);
  $pdf->drawRect($margin + 70, $y, $contentW - 70, 6);
  $pdf->drawText($margin + 2, $y + 1, 'Date de mise en service', 7, 'Helvetica-Bold');
  $pdf->drawText($margin + 72, $y + 1, $dateStr, 8, 'Helvetica', '', [13, 25, 90]);
  $y += 10;

  // Section 4: Matériel installé
  $pdf->drawText($margin, $y, 'Matériel installé', 10, 'Helvetica-Bold', '', [13, 25, 90]);
  $y += 6;
  $matRows = [
    ['ONT', $d['ont_sn'] ?? $d['sn'] ?? ''],
    ['PTO', (string)($d['pto_qte'] ?? '')],
    ['Répéteur WiFi', (string)($d['repeteur_wifi_qte'] ?? '')],
    ['Emplacement ONT', $d['emplacement_ont'] ?? ''],
  ];
  foreach ($matRows as $row) {
    $pdf->drawRect($margin, $y, 70, 6);
    $pdf->drawRect($margin + 70, $y, $contentW - 70, 6);
    $pdf->drawText($margin + 2, $y + 1, $row[0], 7, 'Helvetica-Bold');
    $pdf->drawText($margin + 72, $y + 1, utf8_decode($row[1]), 8, 'Helvetica', '', [13, 25, 90]);
    $y += 6;
  }
  $y += 4;

  // Section 5: Appréciation / Remarques
  $pdf->drawRect($margin, $y, $contentW, 20);
  $pdf->drawText($margin + 2, $y + 2, 'Appréciation / Remarques', 7, 'Helvetica-Bold');
  if ($d['appreciation_satisfaction_libre'] ?? '') {
    $pdf->drawText($margin + 2, $y + 10, utf8_decode($d['appreciation_satisfaction_libre']), 8);
  }
  $y += 24;

  // Signatures
  $halfW = $contentW / 2;
  $pdf->drawSignature($margin, $y, $halfW - 2, 'Client', $d['nom_client'] ?? '', $d['signature_client'] ?? null);
  $pdf->drawSignature($margin + $halfW + 2, $y, $halfW - 2, 'Prestataire', $d['nom_technicien'] ?? '', $d['signature_technicien'] ?? null);

  // ===== Page 2: Fiche de Satisfaction Client =====
  $pdf->AddPage();

  $y = $margin;

  // Header
  $pdf->drawText($margin, $y, 'Fiche de Satisfaction Client', 14, 'Helvetica-Bold', '', [13, 25, 90]);
  $y += 10;
  $pdf->drawLine($margin, $y, $margin + $contentW, $y);
  $y += 8;

  // Reference
  $pdf->drawRect($margin, $y, 70, 6);
  $pdf->drawRect($margin + 70, $y, $contentW - 70, 6);
  $pdf->drawText($margin + 2, $y + 1, 'Référence dossier', 7, 'Helvetica-Bold');
  $pdf->drawText($margin + 72, $y + 1, substr($d['id'] ?? '', 0, 8), 8, 'Helvetica', '', [13, 25, 90]);
  $y += 10;

  // Section 1: Informations client
  $pdf->drawText($margin, $y, 'Informations client', 10, 'Helvetica-Bold', '', [13, 25, 90]);
  $y += 6;
  $infoRows = [
    ['Nom du client / Société', $d['nom_client'] ?? ''],
    ['Téléphone', $d['telephone_ligne'] ?? ''],
    ['Adresse / Zone', $d['adresse_zone'] ?? ''],
    ['Date', $dateStr],
  ];
  foreach ($infoRows as $row) {
    $pdf->drawRect($margin, $y, 70, 6);
    $pdf->drawRect($margin + 70, $y, $contentW - 70, 6);
    $pdf->drawText($margin + 2, $y + 1, $row[0], 7, 'Helvetica-Bold');
    $pdf->drawText($margin + 72, $y + 1, utf8_decode($row[1]), 8, 'Helvetica', '', [13, 25, 90]);
    $y += 6;
  }
  $y += 4;

  // Section 2: Validation
  $pdf->drawText($margin, $y, 'Validation', 10, 'Helvetica-Bold', '', [13, 25, 90]);
  $y += 6;
  $validations = [
    ['Les travaux réalisés correspondent à votre demande', $d['travaux_conformes'] ?? false],
    ['Emplacement des équipements validé', $d['emplacement_valide'] ?? false],
    ['Travail propre et sécurité', $d['travail_propre'] ?? false],
    ['Service testé en votre présence', $d['service_teste'] ?? false],
    ['Le service fonctionne correctement', $d['service_fonctionne'] ?? false],
    ['Explications données', $d['explications_donnees'] ?? false],
    ['Recommanderiez-vous notre entreprise ?', $d['recommanderait'] ?? false],
    ['Acceptez-vous un recontact pour le suivi ?', $d['accepte_recontact'] ?? false],
  ];
  foreach ($validations as $row) {
    $pdf->drawText($margin, $y + 1, utf8_decode($row[0]), 8);
    $pdf->drawCheckbox($margin + $contentW - 22, $y, $row[1]);
    $pdf->drawText($margin + $contentW - 14, $y + 1, 'Oui', 7);
    $pdf->drawCheckbox($margin + $contentW - 8, $y, $row[1] === false);
    $pdf->drawText($margin + $contentW - 0, $y + 1, 'Non', 7);
    $y += 6;
  }
  $y += 4;

  // Section 3: Satisfaction
  $pdf->drawText($margin, $y, 'Niveau de satisfaction', 10, 'Helvetica-Bold', '', [13, 25, 90]);
  $y += 6;
  $niveaux = ['Très satisfait', 'Satisfait', 'Peu satisfait', 'Insatisfait'];
  $ncw = ($contentW - 55) / 4;
  $criteres = [
    ['Qualité de la prestation', $d['qualite'] ?? ''],
    ['Respect des délais', $d['delais'] ?? ''],
    ['Professionnalisme', $d['professionnalisme'] ?? ''],
  ];
  // Header
  $pdf->drawText($margin, $y, 'Critère', 7, 'Helvetica-Bold');
  for ($i = 0; $i < 4; $i++) {
    $pdf->drawText($margin + 55 + $i * $ncw + 2, $y, utf8_decode($niveaux[$i]), 6);
  }
  $y += 6;
  foreach ($criteres as $row) {
    $pdf->drawText($margin, $y + 1, utf8_decode($row[0]), 8);
    for ($i = 0; $i < 4; $i++) {
      $pdf->drawCheckbox($margin + 55 + $i * $ncw + $ncw / 2 - 2, $y + 1, $row[1] === $niveaux[$i]);
    }
    $y += 6;
  }
  $y += 6;

  // Section 4: Déclaration
  $pdf->drawRect($margin, $y, $contentW, 12);
  $pdf->drawText($margin + 2, $y + 2, 'Nom et Prénom du client (déclaration)', 7, 'Helvetica-Bold');
  $pdf->drawText($margin + 2, $y + 8, utf8_decode($d['nom_client_declaration'] ?? $d['nom_client'] ?? ''), 10, 'Helvetica', '', [20, 46, 140]);
  $y += 16;

  // Section 5: Remarque
  $pdf->drawRect($margin, $y, $contentW, 20);
  $pdf->drawText($margin + 2, $y + 2, 'Remarque libre', 7, 'Helvetica-Bold');
  if ($d['remarque_libre'] ?? '') {
    $pdf->drawText($margin + 2, $y + 10, utf8_decode($d['remarque_libre']), 8);
  }
  $y += 24;

  // Signatures
  $pdf->drawSignature($margin, $y, $halfW - 2, 'Nom et Prénom du client', $d['nom_client_declaration'] ?? $d['nom_client'] ?? '', $d['signature_client'] ?? null);
  $pdf->drawSignature($margin + $halfW + 2, $y, $halfW - 2, 'Nom et Prénom du Technicien', $d['nom_technicien'] ?? '', $d['signature_technicien'] ?? null);

  return $pdf;
}

function generateRapportPDF($d) {
  $pdf = new ChaptechPDF();
  $pdf->SetAutoPageBreak(true, 20);
  $margin = 15;
  $pageW = 210;
  $contentW = $pageW - 2 * $margin;

  $pdf->AddPage();
  $y = $margin;

  // Logo
  $logoPath = __DIR__ . '/../templates/logos/logo_sbin.jpg';
  if (file_exists($logoPath)) {
    $pdf->Image($logoPath, $margin, $y, 25);
  }
  $pdf->drawText($margin + 30, $y + 4, 'Rapport d\'intervention - TELECOM BTP Services', 12, 'Helvetica-Bold', '', [13, 25, 90]);
  $y += 12;
  $pdf->drawLine($margin, $y, $margin + $contentW, $y);
  $y += 6;

  // Infos generales
  $pdf->drawText($margin, $y, 'Informations generales', 10, 'Helvetica-Bold', '', [13, 25, 90]);
  $y += 6;
  $infos = [
    ['Chef d\'equipe', $d['nom_technicien'] ?? ''],
    ['Client', $d['nom_client'] ?? ''],
    ['Adresse / Zone', $d['adresse_zone'] ?? ''],
    ['Telephone', $d['telephone_ligne'] ?? ''],
    ['Mobile', $d['mobile'] ?? ''],
    ['Date', date('d/m/Y', strtotime($d['date'] ?? 'now'))],
    ['Etat', $d['etat'] ?? ''],
    ['Statut', ($d['statut'] ?? '') === 'termine' ? 'Terminee' : 'En cours'],
  ];
  foreach ($infos as $row) {
    $pdf->drawRect($margin, $y, 70, 6);
    $pdf->drawRect($margin + 70, $y, $contentW - 70, 6);
    $pdf->drawText($margin + 2, $y + 1, $row[0], 7, 'Helvetica-Bold');
    $pdf->drawText($margin + 72, $y + 1, utf8_decode($row[1]), 8, 'Helvetica', '', [13, 25, 90]);
    $y += 6;
  }
  $y += 4;

  // Donnees techniques
  $pdf->drawText($margin, $y, 'Donnees techniques', 10, 'Helvetica-Bold', '', [13, 25, 90]);
  $y += 6;
  $tech = [
    ['MSAN', $d['msan'] ?? ''],
    ['FAT', $d['fat_ref'] ?? ''],
    ['Port', $d['port'] ?? ''],
    ['Type de cable', $d['type_cable'] ?? ''],
    ['Depart (m)', $d['depart_m'] ?? ''],
    ['Arrivee (m)', $d['arrivee_m'] ?? ''],
    ['Lineaire (m)', $d['lineaire_m'] ?? ''],
    ['Puissance FAT (dBm)', $d['puissance_fat_dbm'] ?? ''],
    ['Puissance PTO (dBm)', $d['puissance_pto_dbm'] ?? ''],
    ['MAC', $d['mac'] ?? ''],
    ['SN / ONT', $d['sn'] ?? ''],
    ['Offre souscrite', $d['offre_souscrite'] ?? ''],
  ];
  foreach ($tech as $row) {
    $pdf->drawRect($margin, $y, 70, 6);
    $pdf->drawRect($margin + 70, $y, $contentW - 70, 6);
    $pdf->drawText($margin + 2, $y + 1, $row[0], 7, 'Helvetica-Bold');
    $pdf->drawText($margin + 72, $y + 1, utf8_decode($row[1]), 8, 'Helvetica', '', [13, 25, 90]);
    $y += 6;
  }
  $y += 4;

  // Materiel pose
  $mp = $d['materiel_pose'] ?? [];
  if (!empty($mp)) {
    $pdf->drawText($margin, $y, 'Materiel pose', 10, 'Helvetica-Bold', '', [13, 25, 90]);
    $y += 6;
    foreach ($mp as $key => $qte) {
      if (!$qte) continue;
      $pdf->drawRect($margin, $y, 70, 6);
      $pdf->drawRect($margin + 70, $y, $contentW - 70, 6);
      $pdf->drawText($margin + 2, $y + 1, $key, 7, 'Helvetica-Bold');
      $pdf->drawText($margin + 72, $y + 1, str_pad($qte, 2, '0', STR_PAD_LEFT), 8, 'Helvetica', '', [13, 25, 90]);
      $y += 6;
    }
    $y += 4;
  }

  // Points GPS avec photos
  $points = $d['points_gps'] ?? [];
  if (!empty($points)) {
    $pdf->drawText($margin, $y, 'Points GPS releves (' . count($points) . ')', 10, 'Helvetica-Bold', '', [13, 25, 90]);
    $y += 8;

    foreach ($points as $point) {
      if ($y > 250) { $pdf->AddPage(); $y = $margin; }

      $label = trim(($point['type'] ?? '') . ' ' . ($point['sous_type'] ?? '') . ' ' . ($point['numero'] ?? ''));
      $pdf->drawText($margin, $y, $label, 10, 'Helvetica-Bold', '', [13, 25, 90]);
      $y += 6;

      // Photo
      $photoW = 80;
      $photoH = 60;
      $hasPhoto = false;
      if (!empty($point['photo'])) {
        $hasPhoto = $pdf->embedPhoto($point['photo'], $margin, $y, $photoW, $photoH);
      }

      $textX = $hasPhoto ? $margin + $photoW + 5 : $margin;
      $pdf->drawText($textX, $y, 'GPS: ' . ($point['lat'] ?? 0) . ', ' . ($point['lng'] ?? 0), 8, 'Helvetica-Bold');
      $pdf->drawText($textX, $y + 5, 'Precision: +/' . ($point['precision_m'] ?? 0) . 'm', 7);
      $pdf->drawText($textX, $y + 10, date('d/m/Y H:i', strtotime($point['horodatage'] ?? 'now')), 7);
      if (!empty($point['proprietaire'])) {
        $pdf->drawText($textX, $y + 15, 'Proprietaire: ' . utf8_decode($point['proprietaire']), 7);
      }
      $pdf->drawText($textX, $y + 20, 'Ajoute par ' . utf8_decode($point['ajoute_par'] ?? ''), 6.5, 'Helvetica', '', [150, 150, 150]);

      $y += $hasPhoto ? $photoH + 5 : 25;
    }
  }

  // Photos WhatsApp (hors rapport)
  $waPhotos = $d['whatsapp_photos'] ?? [];
  if (!empty($waPhotos)) {
    if ($y > 240) { $pdf->AddPage(); $y = $margin; }
    $pdf->drawText($margin, $y, 'Photos terrain (' . count($waPhotos) . ')', 10, 'Helvetica-Bold', '', [13, 25, 90]);
    $y += 8;

    $thumbW = 55;
    $thumbH = 42;
    $thumbGap = 12;
    $cols = 3;
    $colW = $contentW / $cols;
    $rowIdx = 0;

    foreach ($waPhotos as $i => $photo) {
      $col = $i % $cols;
      if ($col === 0 && $i > 0) $rowIdx++;
      $px = $margin + $col * $colW;
      $py = $y + $rowIdx * ($thumbH + $thumbGap);

      if ($py + $thumbH > 275) {
        $pdf->AddPage();
        $y = $margin;
        $rowIdx = 0;
        $py = $y;
      }

      $hasPhoto = $pdf->embedPhoto($photo['url'] ?? '', $px, $py, $thumbW, $thumbH);
      if ($hasPhoto) {
        $pdf->drawText($px, $py + $thumbH + 1, sprintf('%.4f', $photo['lat'] ?? 0) . ', ' . sprintf('%.4f', $photo['lng'] ?? 0), 6);
        $pdf->drawText($px, $py + $thumbH + 5, date('d/m/Y H:i', strtotime($photo['horodatage'] ?? 'now')), 6);
      } else {
        $pdf->drawText($px, $py, 'Photo ' . ($i + 1), 7);
      }
    }
    $totalRows = ceil(count($waPhotos) / $cols);
    $y += $totalRows * ($thumbH + $thumbGap);
  }

  return $pdf;
}

// ===== Routing =====
$action = $_GET['action'] ?? '';
$id = $_GET['id'] ?? '';

if (!$id) {
  http_response_code(400);
  echo json_encode(['error' => 'ID requis']);
  exit;
}

$d = getIntervention($id);
if (!$d) {
  http_response_code(404);
  echo json_encode(['error' => 'Intervention introuvable']);
  exit;
}

try {
  if ($action === 'pdf_fiches') {
    $pdf = generateFichesPDF($d);
    $filename = 'fiches_' . ($d['nom_client'] ?? $id) . '.pdf';
    header('Content-Type: application/pdf');
    header('Content-Disposition: attachment; filename="' . $filename . '"');
    header('Access-Control-Allow-Origin: *');
    $pdf->Output('D', $filename);
  } elseif ($action === 'pdf_rapport') {
    $pdf = generateRapportPDF($d);
    $filename = 'rapport_' . ($d['nom_client'] ?? $id) . '.pdf';
    header('Content-Type: application/pdf');
    header('Content-Disposition: attachment; filename="' . $filename . '"');
    header('Access-Control-Allow-Origin: *');
    $pdf->Output('D', $filename);
  } elseif ($action === 'pdf_fiches_view') {
    $pdf = generateFichesPDF($d);
    header('Content-Type: application/pdf');
    header('Access-Control-Allow-Origin: *');
    $pdf->Output('I');
  } elseif ($action === 'pdf_rapport_view') {
    $pdf = generateRapportPDF($d);
    header('Content-Type: application/pdf');
    header('Access-Control-Allow-Origin: *');
    $pdf->Output('I');
  } else {
    http_response_code(404);
    echo json_encode(['error' => 'Action PDF inconnue: ' . $action]);
  }
} catch (Exception $e) {
  http_response_code(500);
  echo json_encode(['error' => $e->getMessage()]);
}
